###
# Login
POST {{baseUrl}}/api/accounts/login/
Content-Type: application/json

{
    "email": "johndoe@example.com",
    "password": "Johndoe123!"
}


###
# Refresh Token
POST {{baseUrl}}/api/accounts/token/refresh/
Content-Type: application/json

{
    "refresh": "{{refreshToken}}"
}


###
# Get logged in Customer Profile 
GET {{baseUrl}}/api/customers/profile/
Authorization: Bearer {{accessToken}}

###
# Update logged in Customer Profile
# Can also update: Phone_no, first_name and last_name
PATCH {{baseUrl}}/api/customers/profile/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "address": "25 Zik's Avenue",
    "city": "Awka",
    "state": "Anambra",
    "first_name": "John"
}