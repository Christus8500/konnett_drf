####################### JOB REQUESTS ########################

POST {{baseUrl}}/api/jobs/
Content-Type: application/json
Authorization: Bearer {{customerAccessToken}}

{
    "category": "93664e8e-6314-4212-ae17-5f369ffa02d4",
    "title": "Get My Waybill",
    "description": "lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed euismod, nunc ut aliquam aliquam",
    "points_amount": "500",
    "deadline": "2026-08-05T14:30:00Z",
    "job_address": "26 Oguta Road",
    "city": "Onitsha",
    "state": "Anambra"

}

###
# Get Jobs
# Admin can get all jobs
# Customers can only get their jobs
# Providers can only get jobs that are pending
GET {{baseUrl}}/api/jobs/
Authorization: Bearer {{providerAccessToken}}

########### Searches ##########
GET {{baseUrl}}/api/jobs/?search=Take+me+to+school
Authorization: Bearer {{customerAccessToken}}

########### Filters ##########
GET {{baseUrl}}/api/jobs/?category__name__icontains=transport&status__iexact=cancelled
Authorization: Bearer {{customerAccessToken}}

###
# Get A Job
GET {{baseUrl}}/api/jobs/45ace3ac-f16e-419c-8b67-8ab8a89f28aa/
Authorization: Bearer {{customerAccessToken}}

###
# Update A Job
# Customers can only update their jobs, if the job is still pending
PATCH {{baseUrl}}/api/jobs/45ace3ac-f16e-419c-8b67-8ab8a89f28aa/
Content-Type: application/json
Authorization: Bearer {{customerAccessToken}}

{
    "points_amount": "600"
}

###
# Delete A Job
# Customers can only delete their jobs, if the job is still pending
DELETE  {{baseUrl}}/api/jobs/45ace3ac-f16e-419c-8b67-8ab8a89f28aa/
Authorization: Bearer {{customerAccessToken}}


####################### REQUEST IMAGE ########################

# POST image with postman
POST  {{baseUrl}}/api/jobs/45ace3ac-f16e-419c-8b67-8ab8a89f28aa/images/
Authorization: Bearer {{customerAccessToken}}

###
# Delete A Job's image
# Customers can only delete, if the job is still pending
DELETE  {{baseUrl}}/api/jobs/images/105d7caa-2380-44d2-984d-80e8bc2059e1/
Authorization: Bearer {{customerAccessToken}}


####################### REQUEST OFFER ########################

###
# Send Offer
# Verified providers can only send 1 offer, if the job is still pending
POST  {{baseUrl}}/api/jobs/45ace3ac-f16e-419c-8b67-8ab8a89f28aa/offers/
Authorization: Bearer {{providerAccessToken}}

###
# Get Job Offers
# Only by the customer that owns the job
GET  {{baseUrl}}/api/jobs/45ace3ac-f16e-419c-8b67-8ab8a89f28aa/offers/
Authorization: Bearer {{customerAccessToken}}

###
# Get Provider Offers
# Returns all provider offers 
# Only by the provider that own the offers
GET  {{baseUrl}}/api/jobs/provider/offers/
Authorization: Bearer {{providerAccessToken}}

###
# Accept Job Offer
# Only by the customer that owns the job
PATCH  {{baseUrl}}/api/jobs/offers/8aa1a8a9-0abb-4c89-999e-c3777ae85095/accept/
Authorization: Bearer {{customerAccessToken}}

###
# Reject Job Offer
# Only by the customer that owns the job
PATCH  {{baseUrl}}/api/jobs/offers/8aa1a8a9-0abb-4c89-999e-c3777ae85095/reject/
Authorization: Bearer {{customerAccessToken}}

###
# Withdraw Job Offer
# Only by the provider that sent the offer
PATCH  {{baseUrl}}/api/jobs/offers/8aa1a8a9-0abb-4c89-999e-c3777ae85095/withdraw/
Authorization: Bearer {{providerAccessToken}}


####################### COMPLETION ########################

###
# Send Completion Image in POSTMAN
# Only by the provider that was accepted
POST  {{baseUrl}}/api/jobs/45ace3ac-f16e-419c-8b67-8ab8a89f28aa/completion-images/
Authorization: Bearer {{providerAccessToken}}

###
# Request Completion
# Only by the provider that was accepted 
PATCH  {{baseUrl}}/api/jobs/45ace3ac-f16e-419c-8b67-8ab8a89f28aa/request-completion/
Authorization: Bearer {{providerAccessToken}}

###
# Confirm Completion
# Only by the customer that owns the job
PATCH  {{baseUrl}}/api/jobs/45ace3ac-f16e-419c-8b67-8ab8a89f28aa/confirm-completion/
Authorization: Bearer {{customerAccessToken}}


####################### DISPUTE ########################

###
# Create dispute for a job
# Only by the customer that owns the job
POST  {{baseUrl}}/api/jobs/45ace3ac-f16e-419c-8b67-8ab8a89f28aa/dispute/
Authorization: Bearer {{customerAccessToken}}
Content-Type: application/json

{
    "customer_reason": "The worker did a shitty job"
}

###
# Get Dispute
# Only by the admin or the customer that owns the dispute
GET  {{baseUrl}}/api/jobs/disputes/6c85650c-53de-4892-829b-7b957b918e78/
Authorization: Bearer {{customerAccessToken}}

###
# Resolve Dispute
# Only by the admin
PATCH  {{baseUrl}}/api/jobs/disputes/6c85650c-53de-4892-829b-7b957b918e78/resolve/
Authorization: Bearer {{customerAccessToken}}
Content-Type: application/json

{
    "admin_note": "The work looks fine to me",
    "decision": "release points"
}






###
# Refresh Token
POST {{baseUrl}}/api/accounts/token/refresh/
Content-Type: application/json

{
    "refresh": "{{refreshToken}}"
}