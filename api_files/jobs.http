####################### JOB REQUESTS ########################

POST {{baseUrl}}/api/jobs/
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "category": "93664e8e-6314-4212-ae17-5f369ffa02d4",
    "title": "Take me to shoprite",
    "description": "I am going shopping",
    "points_amount": "500",
    "deadline": "2026-07-31T14:30:00Z",
    "job_address": "26 Oguta Road",
    "city": "Onitsha",
    "state": "Anambra"

}

###
# Get Jobs
# Admin can get all jobs
# Customers can only get their jobs
# Providers can only get jobs that are pending
GET {{baseUrl}}/api/jobs/
Authorization: Bearer {{accessToken}}

########### Searches ##########
GET {{baseUrl}}/api/jobs/?search=Take+me+to+school
Authorization: Bearer {{accessToken}}

########### Filters ##########
GET {{baseUrl}}/api/jobs/?category__name__icontains=transport&status__iexact=cancelled
Authorization: Bearer {{accessToken}}

###
# Get A Job
GET {{baseUrl}}/api/jobs/af56845f-7615-45ff-8b98-60006bab8f4e/
Authorization: Bearer {{accessToken}}

###
# Update A Job
# Customers can only update their jobs, if the job is still pending
PATCH {{baseUrl}}/api/jobs/4d9ffbd7-4943-4294-913e-49d8d7309ed9/
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "points_amount": "600"
}

###
# Delete A Job
# Customers can only delete their jobs, if the job is still pending
DELETE  {{baseUrl}}/api/jobs/4d9ffbd7-4943-4294-913e-49d8d7309ed9/
Authorization: Bearer {{accessToken}}


####################### REQUEST IMAGE ########################

# POST image with postman
POST  {{baseUrl}}/api/jobs/af56845f-7615-45ff-8b98-60006bab8f4e/images/
Authorization: Bearer {{accessToken}}

###
# Delete A Job's image
# Customers can only delete, if the job is still pending
DELETE  {{baseUrl}}/api/jobs/images/105d7caa-2380-44d2-984d-80e8bc2059e1/
Authorization: Bearer {{accessToken}}


####################### REQUEST OFFER ########################

###
# Send Offer
# Verified providers can only send 1 offer, if the job is still pending
POST  {{baseUrl}}/api/jobs/af56845f-7615-45ff-8b98-60006bab8f4e/offers/
Authorization: Bearer {{accessToken}}

###
# Get Job Offers
# Only by the customer that owns the job
GET  {{baseUrl}}/api/jobs/af56845f-7615-45ff-8b98-60006bab8f4e/offers/
Authorization: Bearer {{accessToken}}

###
# Get Provider Offers
# Returns all provider offers that are pending 
# Only by the provider that sent the offers
GET  {{baseUrl}}/api/jobs/provider/offers/
Authorization: Bearer {{accessToken}}

###
# Accept Job Offer
# Only by the customer that owns the job
PATCH  {{baseUrl}}/api/jobs/offers/f82ac57d-7ac3-4408-b5ae-636789dd9a84/accept/
Authorization: Bearer {{accessToken}}

###
# Reject Job Offer
# Only by the customer that owns the job
PATCH  {{baseUrl}}/api/jobs/offers/f82ac57d-7ac3-4408-b5ae-636789dd9a84/reject/
Authorization: Bearer {{accessToken}}

###
# Withdraw Job Offer
# Only by the provider that sent the offer
PATCH  {{baseUrl}}/api/jobs/offers/f82ac57d-7ac3-4408-b5ae-636789dd9a84/withdraw/
Authorization: Bearer {{accessToken}}


####################### COMPLETION ########################

###
# Send Completion Image in POSTMAN
# Only by the provider that was accepted
POST  {{baseUrl}}/api/jobs/af56845f-7615-45ff-8b98-60006bab8f4e/completion-images/
Authorization: Bearer {{accessToken}}

###
# Request Completion
# Only by the provider that was accepted 
PATCH  {{baseUrl}}/api/jobs/af56845f-7615-45ff-8b98-60006bab8f4e/request-completion/
Authorization: Bearer {{accessToken}}

###
# Confirm Completion
# Only by the customer that owns the job
PATCH  {{baseUrl}}/api/jobs/af56845f-7615-45ff-8b98-60006bab8f4e/confirm-completion/
Authorization: Bearer {{accessToken}}


####################### DISPUTE ########################

###
# Create dispute for a job
# Only by the customer that owns the job
POST  {{baseUrl}}/api/jobs/af56845f-7615-45ff-8b98-60006bab8f4e/dispute/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "customer_reason": "The worker did a shitty job"
}

###
# Get Dispute
# Only by the admin or the customer that owns the dispute
GET  {{baseUrl}}/api/jobs/disputes/6c85650c-53de-4892-829b-7b957b918e78/
Authorization: Bearer {{accessToken}}

###
# Resolve Dispute
# Only by the admin
PATCH  {{baseUrl}}/api/jobs/disputes/6c85650c-53de-4892-829b-7b957b918e78/resolve/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
    "admin_note": "The work looks fine to me",
    "decision": "release points"
}






###
# Refresh Token
POST {{baseUrl}}/api/accounts/token/refresh/
Content-Type: application/json

{
    "refresh": "{{refreshToken}}"
}