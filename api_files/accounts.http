###
# Login
POST {{baseUrl}}/api/accounts/login/
Content-Type: application/json

{
    "email": "konnettuser@gmail.com",
    "password": "konnett$2500"
}

###
# Refresh Token
POST {{baseUrl}}/api/accounts/token/refresh/
Content-Type: application/json

{
    "refresh": "{{refreshToken}}"
}

###
# Users list (Only admin)
GET {{baseUrl}}/api/accounts/users/
Authorization: Bearer {{accessToken}}

###
# Register Customer
POST {{baseUrl}}/api/accounts/register/
Content-Type: application/json

{
    "email": "johndoe@example.com",
    "phone_number": "09056659000",
    "password": "Johndoe123!",
    "confirm_password": "Johndoe123!",
    "first_name": "John",
    "last_name": "Doe",
    "role": "customer"
}

###
# Register Provider
POST {{baseUrl}}/api/accounts/register/
Content-Type: application/json

{
    "email": "thehulk@example.com",
    "phone_number": "09056695000",
    "password": "Thehulk123!",
    "confirm_password": "Thehulk123!",
    "first_name": "Bruce",
    "last_name": "Barner",
    "role": "provider"
}

###
# Login
POST {{baseUrl}}/api/accounts/login/
Content-Type: application/json

{
    "email": "thehulk@example.com",
    "password": "Thehulk123!"
}

###
# Me
GET {{baseUrl}}/api/accounts/me/
Authorization: Bearer {{accessToken}}